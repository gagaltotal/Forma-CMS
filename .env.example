# Salin menjadi .env lalu isi. JANGAN commit file .env.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# URL publik tempat panel admin diakses (WAJIB https:// di production).
# Dipakai untuk flag cookie Secure, cek Origin (anti-CSRF) dan URL file media.
PUBLIC_URL=https://cms.example.com

# Rahasia untuk rantai HMAC audit log. Buat dengan:  openssl rand -hex 32
APP_SECRET=

# --- Database: sqlite | postgres | mysql ---
DB_CLIENT=sqlite
SQLITE_PATH=./data/forma.db
# Untuk PostgreSQL / MySQL (MariaDB) bagian localhost bisa di ganti host target DB:
# DB_CLIENT=postgres
# DATABASE_URL=postgres://forma:password@localhost:5432/forma
# DB_CLIENT=mysql
# DATABASE_URL=mysql://forma:password@localhost:3306/forma

# --- Media ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# --- Di belakang reverse proxy (Nginx/Caddy/Traefik)? ---
# Aktifkan HANYA jika proxy tepercaya yang menambahkan X-Forwarded-For.
# Jika salah dikonfigurasi, penyerang bisa memalsukan IP dan menghindari rate limit.
TRUST_PROXY=false

# --- CORS: origin frontend yang boleh memanggil API (pisahkan dengan koma). Kosong = same-origin saja ---
CORS_ORIGINS=

# --- Sesi ---
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# --- Rate limit ---
RATE_LIMIT_PER_MINUTE=300
LOGIN_MAX_PER_15MIN=10
# IP server frontend (SSR) yang dikecualikan dari rate limit UMUM (login tetap dibatasi):
RATE_LIMIT_ALLOWLIST=

# --- GraphQL ---
GRAPHQL_INTROSPECTION=false

# --- SSO (OIDC / OAuth2) ---
# Login tunggal (Google, Azure AD, Keycloak, Okta, Auth0, ...). Bersifat provider-agnostic.
# PENTING: pengguna harus SUDAH terdaftar di Forma CMS (dibuat via CLI/Roles). SSO tidak
# membuat akun baru otomatis. Tersedia untuk SEMUA role; izin tetap mengikuti role di CMS.
# Semua tombol SSO di halaman login memakai `info` publik -> tidak ada rahasia yang bocor ke browser.
SSO_ENABLED=false
# Label tombol di halaman login, mis. "Google", "Azure AD", "Keycloak".
SSO_PROVIDER_NAME=SSO
# Issuer OIDC (harus mengarah ke discovery: <issuer>/.well-known/openid-configuration).
# Contoh: https://accounts.google.com  |  https://login.microsoftonline.com/<tenant>/v2.0
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Opsional. Default: <PUBLIC_URL>/api/auth/sso/callback (harus terdaftar di penyedia).
# SSO_REDIRECT_URI=https://cms.example.com/api/auth/sso/callback
SSO_SCOPES=openid email profile
# Masa berlaku state PKCE (menit).
SSO_STATE_TTL_MINUTES=10

# --- Landing page ---
# Saat boot, buat tipe konten `home` + satu entri premium bila belum ada (agar `/` langsung rapi).
# Set `false` jika Anda ingin mengelola halaman depan sepenuhnya manual.
SEED_HOMEPAGE_ON_BOOT=true
