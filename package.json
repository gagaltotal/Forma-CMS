{
  "name": "forma-cms",
  "version": "0.1.0",
  "description": "Forma: developer-first, secure, self-hostable headless CMS (Node.js + TypeScript)",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:visual": "npm run build:admin && tsx scripts/visual-check.ts",
    "build:admin": "node scripts/build-admin.mjs",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:server && npm run build:admin",
    "start": "node dist/server.js",
    "dev": "npm run build:admin && tsx watch src/server.ts",
    "cli": "node dist/cli.js",
    "typecheck": "tsc --noEmit && tsc -p admin/tsconfig.json",
    "cli:dev": "tsx src/cli.ts",
    "seed:homepage": "tsx scripts/seed-homepage.mjs"
  },
  "keywords": [
    "cms",
    "headless-cms",
    "typescript",
    "graphql",
    "self-hosted"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "graphql": "^16.14.2",
    "knex": "^3.3.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "qs": "^6.16.0",
    "sanitize-html": "^2.17.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
